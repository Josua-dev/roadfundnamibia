# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (PostgreSQL) ──────────────────────────────────────
# Option A — single connection string (use this for Supabase, Neon,
# Render, Railway, etc. — copy it straight from your provider).
# For the "roadfund" Supabase project already set up for this app:
# Dashboard > Project Settings > Database > Connection string > Direct connection
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option B — discrete vars (used only if DATABASE_URL is unset —
# handy for a plain local Postgres install):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=change_me_strong_password
# DB_NAME=roadfund_system

# Set to "disable" only for a local Postgres with no TLS configured.
# Leave unset for Neon/managed providers (they require SSL).
# PGSSL=disable

# ── Email (Gmail SMTP) ─────────────────────────────────────────
# Uses a Gmail account + App Password to send transactional emails.
# Free, no domain needed, up to 500 recipients/day.
#
# Set up an App Password:
#   1. Enable 2-Factor Authentication on your Google account
#   2. Visit https://myaccount.google.com/apppasswords
#   3. Select "Mail" and your device, then generate
#   4. Copy the 16-character password (no spaces)
#
# Paste the App Password below (not your regular Gmail password).
GMAIL_USER=joshua7919859@gmail.com
GMAIL_APP_PASSWORD=
# Sender display name — change the email part only if you've verified
# a domain in another provider; otherwise keep it as your Gmail address.
EMAIL_FROM=RoadSafe Namibia <joshua7919859@gmail.com>
# Used to build "View Report" links inside notification emails.
# Local dev: http://localhost:5173. Production: your deployed
# frontend's URL (no trailing slash). Leave unset and emails just
# skip the button -- everything else still works.
FRONTEND_URL=http://localhost:5173

# ── File Storage (Supabase Storage) ──────────────────────────────
# Uploaded report/repair photos are stored here instead of local
# disk, which is wiped on every Render redeploy. Reuses the same
# Supabase project as the database -- no separate signup, no card.
#
# Dashboard: Project Settings > API
#   SUPABASE_URL              -> "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY -> "service_role" key (NOT the anon/public
#                                 key -- this one bypasses Row Level
#                                 Security and must never be exposed
#                                 to the frontend or committed anywhere)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=report-photos

# ── Auth ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX
JWT_EXPIRES_IN=7d

# ── Frontend ──────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173

# ── File Uploads ──────────────────────────────────────────────
MAX_FILE_SIZE=10485760
